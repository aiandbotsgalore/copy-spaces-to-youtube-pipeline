# Copy to .env.local and fill in. .env.local is gitignored (*.local).
# Server-side only: read by the Vite dev/preview middleware and Python automation scripts, never exposed to the client bundle.

# Inception Labs (Mercury-3) - Fast Diffusion Reasoning & UI Director
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Cohere API v2 - Long-Context Transcript Ingestion & Highlight Extraction (256k context)
COHERE_API_KEY=

# Optional Director Overrides
DIRECTOR_API_KEY=
DIRECTOR_BASE_URL=
DIRECTOR_MODEL=mercury-3
