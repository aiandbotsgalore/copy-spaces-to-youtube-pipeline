# Copy to .env.local and fill in. .env.local is gitignored (*.local).
# Server-side only: read by the Vite dev/preview middleware and Python automation scripts.
# NEVER prefix private secrets with VITE_ (only variables prefixed with VITE_ reach the browser bundle).

# -----------------------------------------------------------------------------
# 1. AI Prompt Director & Long-Context Ingestion
# -----------------------------------------------------------------------------
# Inception Labs (Mercury-3) - Fast Diffusion Reasoning & UI Director
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1

# Cohere API v2 - Long-Context Transcript Ingestion, Semantic Rerank & Highlight Extraction
COHERE_API_KEY=

# Optional Director Overrides
DIRECTOR_API_KEY=
DIRECTOR_BASE_URL=
DIRECTOR_MODEL=mercury-3

# Optional Fallback / Secondary LLM Keys (Used by transcript scripts & backfills)
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# 2. Speech Synthesis & Voice Cloning (VoxCPM-2)
# -----------------------------------------------------------------------------
HF_TOKEN=
HF_BACKUP_TOKEN=
VOXCPM_SPACE=loganblack0/voxcpm-voice-clone

# -----------------------------------------------------------------------------
# 3. Speech-to-Text, Diarization & Transcription Cloud Engines
# -----------------------------------------------------------------------------
# AssemblyAI (Universal-3 Pro) Speech-to-Text & Diarization
ASSEMBLYAI_API_KEY=

# Hugging Face ZeroGPU Transcriber Space (WhisperX + PyAnnote)
HF_TRANSCRIBE_ENDPOINT=loganblack0/spacepipe-transcriber
SPACE_API_KEY=

# Local Whisper Engine Overrides (Optional: "base", "small", "medium", "large-v3")
WHISPER_MODEL=base
WHISPER_BEAM_SIZE=5

# -----------------------------------------------------------------------------
# 4. Vector Database (Qdrant)
# -----------------------------------------------------------------------------
# Used for semantic transcript search and vector indexing
QDRANT_URL=
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# 5. Cloudflare R2 Audio CDN & Object Storage
# -----------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=documentary-audio-clips
R2_PUBLIC_BASE_URL=https://pub-<hash>.r2.dev

# -----------------------------------------------------------------------------
# 6. Video Avatars & Lip-Sync (Modal LivePortrait)
# -----------------------------------------------------------------------------
LIVEPORTRAIT_API_URL=
MODAL_PROFILE=

# -----------------------------------------------------------------------------
# 7. GitHub Automation & Releases
# -----------------------------------------------------------------------------
# Personal Access Token for release asset downloads, queue processing, and workflow dispatch
GITHUB_TOKEN=

# -----------------------------------------------------------------------------
# 8. Twitter / X Spaces Monitoring & Ingestion (Optional)
# -----------------------------------------------------------------------------
X_AUTH_TOKEN=
X_CT0=
X_HANDLES=

# -----------------------------------------------------------------------------
# 9. Client-Side Bundle Variables (Public to browser)
# -----------------------------------------------------------------------------
# Optional Cloudflare Edge Slicer Worker URL (e.g. https://spacepipe-edge-slicer.<subdomain>.workers.dev)
# If omitted or commented out, the UI routes audio slicing through local Vite /api/montage/audio proxy
# VITE_EDGE_SLICER_URL=
