[Unit]
Description=SpacePipe 24/7 Live Twitter Space Recorder Daemon
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/spacepipe
EnvironmentFile=/opt/spacepipe/.env
ExecStart=/usr/bin/node scripts/live_recorder_daemon.mjs
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
